{
  "name": "lore-llm-desktop",
  "productName": "Lore LLM Desktop",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop editor for the knowledge base shared between you and your agents.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,blue \"vite\" \"wait-on tcp:5173 && cross-env LORE_DEV_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build --mode web",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/kb/*.test.ts electron/*.test.cjs scripts/*.test.mjs",
    "test:ui": "node --test --test-concurrency=1 test/ui.test.mjs",
    "dist": "npm run build && electron-builder",
    "icons": "node scripts/render-icons.mjs",
    "dist:mas": "npm run build && electron-builder --mac mas --universal",
    "upload:mas": "sh scripts/upload-mas.sh",
    "ota:publish": "node scripts/publish-ota.mjs"
  },
  "build": {
    "appId": "it.lore.llm",
    "productName": "Lore LLM Desktop",
    "icon": "build/icon.png",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Office"
    },
    "protocols": [
      {
        "name": "Lore LLM",
        "schemes": [
          "lore"
        ]
      }
    ],
    "mas": {
      "type": "distribution",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false,
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "ElectronTeamID": "ZVCQ7Q6256"
      }
    }
  },
  "dependencies": {
    "diff": "^8.0.4",
    "marked": "^16.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1",
    "@types/react-dom": "~19.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "material-symbols": "^0.47.5",
    "playwright-core": "^1.56.1",
    "react-native": "^0.81.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  }
}
