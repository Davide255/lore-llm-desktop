# Live-update (OTA) folder for Lore LLM Desktop: static files only. See docs/OTA.md.
Options -Indexes

# Plain 404/403 here: the site-wide error page redirects, and the app refuses redirects.
ErrorDocument 404 "Not found"
ErrorDocument 403 "Forbidden"

# One signed manifest per channel: <channel>/manifest.json + <channel>/manifest.sig.
<FilesMatch "^manifest\.(json|sig)$">
  Header set Cache-Control "private, max-age=0, no-cache, no-store, must-revalidate"
</FilesMatch>

# Files are addressed by their sha256 and never change.
<FilesMatch "^[0-9a-f]{64}$">
  ForceType application/octet-stream
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Keep the site's catch-all rewrite (PWA) away from this folder: a missing
# file must be a real 404, not index.html with status 200.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ - [L]
</IfModule>
