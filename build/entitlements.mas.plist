<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: everything runs in the App Sandbox. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Electron's processes talk over Mach ports in the app group. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>ZVCQ7Q6256.it.lore.llm</string>
  </array>
  <!-- The Lore server (HTTPS). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Sign-in: the browser hands the code back to a loopback listener on localhost:42813. -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- The local copy for Obsidian: a folder the user picks, kept across launches with a security-scoped bookmark. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- Read-only: Obsidian's vault list, to tell whether the local copy is open in Obsidian. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/Library/Application Support/obsidian/</string>
  </array>
</dict>
</plist>
